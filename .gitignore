# capturas do scripts/capturar-fixtures.sh interrompidas no meio
src/test/resources/lab-real/.captura.*

# fixtures reais do lab (nomes e descricoes de projetos de verdade: nao publicar)
src/test/resources/lab-real/

# pacote do agente montado por `./gradlew empacotarAgente` (vem do repositório do agente e pode ter dado pessoal): nunca versionar
src/main/resources/agente/agente-*.tar.gz
